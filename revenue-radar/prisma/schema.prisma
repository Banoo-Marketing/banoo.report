generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  gmailToken    GmailToken?
  emailThreads  EmailThread[]
  opportunities OpportunitySignal[]
  churnSignals  ChurnSignal[]
  reactivations ReactivationContact[]
  emailDrafts   EmailDraft[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model GmailToken {
  id              String    @id @default(cuid())
  userId          String    @unique
  accessToken     String    @db.Text
  refreshToken    String    @db.Text
  expiresAt       DateTime
  lastHistoryId   String?
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailThread {
  id                  String    @id @default(cuid())
  userId              String
  gmailThreadId       String
  subject             String
  snippet             String    @db.Text
  participants        String[]
  lastMessageAt       DateTime
  isProcessed         Boolean   @default(false)
  isHumanConversation Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     EmailMessage[]
  opportunities OpportunitySignal[]
  churnSignals ChurnSignal[]

  @@unique([userId, gmailThreadId])
  @@index([userId, lastMessageAt])
  @@index([userId, isProcessed])
}

model EmailMessage {
  id             String   @id @default(cuid())
  threadId       String
  gmailMessageId String
  from           String
  to             String[]
  subject        String
  bodyText       String   @db.Text
  sentAt         DateTime
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  thread EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, gmailMessageId])
  @@index([threadId, sentAt])
}

model OpportunitySignal {
  id                String   @id @default(cuid())
  userId            String
  threadId          String?
  contactName       String
  company           String?
  opportunityScore  Int
  estimatedValue    String?
  reason            String   @db.Text
  evidence          String[]
  recommendedAction String   @db.Text
  status            String   @default("new")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread EmailThread? @relation(fields: [threadId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, opportunityScore])
}

model ChurnSignal {
  id                String   @id @default(cuid())
  userId            String
  threadId          String?
  client            String
  churnScore        Int
  riskLevel         String
  reasons           String[]
  recommendedAction String   @db.Text
  status            String   @default("new")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread EmailThread? @relation(fields: [threadId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, churnScore])
}

model ReactivationContact {
  id                  String   @id @default(cuid())
  userId              String
  email               String
  name                String
  company             String?
  lastContactDate     DateTime
  reactivationReason  String   @db.Text
  recommendedOffer    String   @db.Text
  emailDraft          String   @db.Text
  status              String   @default("pending")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastContactDate])
}

model EmailDraft {
  id        String   @id @default(cuid())
  userId    String
  threadId  String?
  to        String
  subject   String
  body      String   @db.Text
  tone      String   @default("professional")
  status    DraftStatus @default(DRAFT)
  sentAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

enum DraftStatus {
  DRAFT
  APPROVED
  SENT
}
