generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  gmailToken        GmailToken?
  opportunities     Opportunity[]
  churnSignals      ChurnSignal[]
  retentionInsights RetentionInsight[]
  reactivationTargets ReactivationTarget[]
  outreachLists     MonthlyOutreachList[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model GmailToken {
  id            String    @id @default(cuid())
  userId        String    @unique
  accessToken   String    @db.Text
  refreshToken  String    @db.Text
  expiresAt     DateTime
  lastHistoryId String?
  lastSyncAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailThread {
  id                  String   @id @default(cuid())
  userId              String
  gmailThreadId       String
  subject             String
  snippet             String   @db.Text
  participants        String[]
  lastMessageAt       DateTime
  isProcessed         Boolean  @default(false)
  isHumanConversation Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  messages          EmailMessage[]
  opportunities     Opportunity[]
  churnSignals      ChurnSignal[]
  retentionInsights RetentionInsight[]

  @@unique([userId, gmailThreadId])
  @@index([userId, lastMessageAt])
  @@index([userId, isProcessed])
}

model EmailMessage {
  id             String   @id @default(cuid())
  threadId       String
  gmailMessageId String
  from           String
  to             String[]
  subject        String
  bodyText       String   @db.Text
  sentAt         DateTime
  createdAt      DateTime @default(now())

  thread EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, gmailMessageId])
}

model Opportunity {
  id                String   @id @default(cuid())
  userId            String
  threadId          String?
  contactName       String
  company           String?
  opportunityScore  Int
  revenueConfidence Int?
  estimatedValue    String?
  reason            String   @db.Text
  evidence          String[]
  suggestedAction   String   @db.Text
  status            String   @default("new")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread EmailThread? @relation(fields: [threadId], references: [id])

  @@index([userId, opportunityScore])
}

model ChurnSignal {
  id                String   @id @default(cuid())
  userId            String
  threadId          String?
  clientName        String
  churnScore        Int
  riskLevel         String
  reasons           String[]
  whatHappened      String?  @db.Text
  whyItMatters      String?  @db.Text
  recommendedAction String   @db.Text
  status            String   @default("new")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread EmailThread? @relation(fields: [threadId], references: [id])

  @@index([userId, churnScore])
}

model RetentionInsight {
  id              String   @id @default(cuid())
  userId          String
  threadId        String?
  clientName      String
  insight         String   @db.Text
  suggestedMessage String  @db.Text
  timing          String
  status          String   @default("new")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread EmailThread? @relation(fields: [threadId], references: [id])

  @@index([userId, createdAt])
}

model ReactivationTarget {
  id               String   @id @default(cuid())
  userId           String
  email            String
  contactName      String
  company          String?
  lastContactDate  DateTime
  history          String   @db.Text
  whyContact       String?  @db.Text
  suggestedOffer   String   @db.Text
  suggestedMessage String   @db.Text
  status           String   @default("pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastContactDate])
}

model MonthlyOutreachList {
  id          String   @id @default(cuid())
  userId      String
  month       String
  contacts    Json
  generatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
}
