# Copy to .env and fill in your values
ANTHROPIC_API_KEY=sk-ant-...

# Database (auto-set by docker-compose for containers, override for local dev)
DATABASE_URL=postgresql://brain:brainpass@localhost:5432/company_brain

# Redis
REDIS_URL=redis://localhost:6379/0

# Optional: HubSpot (leave blank to use mock data)
HUBSPOT_PRIVATE_TOKEN=

# Optional: Gmail OAuth (leave blank to use mock data)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Security
SECRET_KEY=change-me-in-production-32-chars-min

# App settings
ENVIRONMENT=development
APPROVAL_REQUIRED=true   # Always true in production – never auto-execute
