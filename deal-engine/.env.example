# Google OAuth — use Desktop app credentials from Google Cloud Console
# Run `npm run setup` once to generate GOOGLE_REFRESH_TOKEN
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Gmail sender address
SENDER_EMAIL=emod@banoo.marketing

# Anthropic Claude API
ANTHROPIC_API_KEY=

# SEMrush — for finding PI firms actively spending on Google Ads
SEMRUSH_API_KEY=

# Google Custom Search (optional — for finding new firms via web search)
# Create a CSE at: https://programmablesearchengine.google.com/
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
